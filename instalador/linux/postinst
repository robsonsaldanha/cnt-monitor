#!/bin/sh
# Depois de instalar ou atualizar: pasta de dados, serviço ligado e o ícone aberto na tela de quem está usando o PC.
set -e

if [ "$1" = "configure" ]; then
    mkdir -p /var/lib/cnt-monitor
    chmod 755 /var/lib/cnt-monitor
    [ -f /var/lib/cnt-monitor/segredos.bin ] && chmod 600 /var/lib/cnt-monitor/segredos.bin
    ln -sf /opt/cnt-monitor/cnt-monitor /usr/bin/cnt-monitor
    # o serviço abre o ícone na sessão gráfica quando volta (mesmo aviso usado pela atualização automática)
    echo instalado > /var/lib/cnt-monitor/reabrir_icone.flag
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl enable cnt-monitor.service >/dev/null 2>&1 || true
        systemctl restart cnt-monitor.service || true
    fi
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications || true
    command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
fi
exit 0
